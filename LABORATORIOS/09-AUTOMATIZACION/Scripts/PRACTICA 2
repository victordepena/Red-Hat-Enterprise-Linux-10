===============================================================================
PRACTICA 2: DESPLIEGUE DE UNA VM CON TERRAFORM EN AWS (EC2)
===============================================================================

-------------------------------------------------------------------------------
PASO 1: INSTALACIÓN DE TERRAFORM EN RHEL 10 (ANSIBLE CONTROLLER)
-------------------------------------------------------------------------------
# 1. Instalar utilidades de Yum/DNF
sudo dnf install -y yum-utils

# 2. Agregar el repositorio oficial de HashiCorp para RHEL
sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo

# 3. Instalar Terraform
sudo dnf install -y terraform

# 4. Verificar la instalación
terraform -v

-------------------------------------------------------------------------------
PASO 2: CONFIGURACIÓN DE CREDENCIALES DE AWS
-------------------------------------------------------------------------------
# Exporta tus credenciales de AWS en la sesión de terminal antes de usar Terraform:
export AWS_ACCESS_KEY_ID="TU_ACCESS_KEY_DE_AWS"
export AWS_SECRET_ACCESS_KEY="TU_SECRET_KEY_DE_AWS"
export AWS_DEFAULT_REGION="us-east-1"

-------------------------------------------------------------------------------
PASO 3: CREACIÓN DEL ARCHIVO DE TERRAFORM (main.tf)
-------------------------------------------------------------------------------
# Crea un directorio para tu proyecto y entra en él:
mkdir -p ~/terraform-aws && cd ~/terraform-aws

# Crea el archivo main.tf:
cat << 'EOF' > main.tf
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# Registrar la llave pública del servidor Controller en AWS
resource "aws_key_pair" "ansible_key" {
  key_name   = "ansible-controller-key"
  public_key = "ssh-rsa PEGA_AQUI_EL_CONTENIDO_DE_TU_LLAVE_PUBLICA_~/.ssh/id_rsa.pub"
}

# Crear Grupo de Seguridad (Permitir SSH port 22 y HTTP port 80)
resource "aws_security_group" "sg_OS3vm" {
  name        = "sg_OS3vm"
  description = "Permitir SSH y HTTP para OS3vm"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# Buscar automáticamente la AMI oficial de Ubuntu 22.04 LTS
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # ID Oficial de Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

# Desplegar la Instancia EC2 con las especificaciones solicitadas
resource "aws_instance" "OS3vm" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "t3.micro" # 1 vCPU, 1 GB RAM (Equivalente al plan s-1vcpu-1gb)
  key_name      = aws_key_pair.ansible_key.key_name
  vpc_security_group_ids = [aws_security_group.sg_OS3vm.id]

  tags = {
    Name = "OS3vm"
  }
}

# Salida que muestra la IP pública creada
output "public_ip" {
  value       = aws_instance.OS3vm.public_ip
  description = "IP publica de la VM para SSH y Ansible"
}
EOF

-------------------------------------------------------------------------------
PASO 4: EJECUCIÓN Y DESPLIEGUE CON TERRAFORM
-------------------------------------------------------------------------------
# 1. Inicializar los proveedores de Terraform
terraform init

# 2. Revisar el plan de ejecución
terraform plan

# 3. Aplicar y crear la máquina virtual en AWS
terraform apply -auto-approve

-------------------------------------------------------------------------------
PASO 5: VALIDACIÓN DEL DESPLIEGUE
-------------------------------------------------------------------------------
# 1. Copia la IP pública que aparece en la salida del comando anterior (public_ip).
# 2. Conéctate vía SSH desde tu servidor Controller hacia la VM creada:
ssh ubuntu@IP_PUBLICA_EC2

# 3. Validación Web:
# Ingresa a la consola de AWS (https://console.aws.amazon.com/ec2)
# Ve a "Instancias" y verifica que la instancia "OS3vm" esté en estado "Running".
===============================================================================
